# Copy to .env and fill in values. Never commit a file that contains real secrets.

# ── Node / Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3500
HOST=0.0.0.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Auth (POST /api/optIn/Auth) ────────────────────────────────────────────────
# Two independent credential sets are accepted by the same running process —
# prod and UAT. Each is checked against the request body's username/password;
# whichever one matches determines which HMAC secret key signs the token, so a
# UAT-issued token can never be produced with the prod secret or vice versa.

# Prod credential set
AUTH_USERNAME=
# Generate with: npm run hash-password -- "yourPassword"  (never store the plaintext password)
AUTH_PASSWORD_HASH=
API_HMAC_SECRET_KEY=

# UAT credential set
UAT_AUTH_USERNAME=
UAT_AUTH_PASSWORD_HASH=
UAT_API_HMAC_SECRET_KEY=

# Shared token settings (src/auth/tokenGenerator.ts). Token format: {timestamp}.{signature}
API_HMAC_ALGORITHM=sha256
# Token validity window, in seconds, from the timestamp it was generated with
API_HMAC_TOKEN_TTL_SECONDS=300

# ── AWS CloudWatch Logs ──────────────────────────────────────────────────────
# Required. The app makes a single, immediate attempt to connect to
# CloudWatch Logs at startup (no retry, no wait) and refuses to start if it
# fails. Once connected, every log line is shipped here in addition to stdout
# (see src/utils/cloudwatch.ts, src/utils/logger.ts).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_LOG_GROUP=
AWS_LOG_STREAM=